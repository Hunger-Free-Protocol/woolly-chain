# Woolly Chain — Environment Configuration
# Copy this file to .env and fill in your values

# Server
WOOLLY_PORT=3000
WOOLLY_DATA_DIR=./data
NODE_ENV=production

# Security — SET THIS for production deployments
WOOLLY_API_KEY=your-secret-api-key-here

# CORS — comma-separated allowed origins (use * for dev only)
CORS_ORIGIN=https://woolly.earth,https://www.woolly.earth

# Rate limiting — express-rate-limit on /api/* (§3.h deploy gate).
# Window length (ms) and max requests per window per client IP.
# Defaults (if unset): 900000 ms (15 min) / 100 requests.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Farm Node (for Pi deployment)
WOOLLY_CHAIN_URL=http://YOUR_GCP_VM_IP:3000
WOOLLY_FARM_ID=FARM-PROTO-001
WOOLLY_SERIAL_PORT=/dev/ttyUSB0
WOOLLY_SERIAL_BAUD=115200
WOOLLY_POLL_INTERVAL=60000
WOOLLY_SUBMIT_INTERVAL=300000
WOOLLY_LAT=12.9716
WOOLLY_LNG=77.5946
WOOLLY_SIMULATE=false
